# Build trees for the vendored native dependencies. Both are reproducible
# from scripts/, and both are far too large to track.
.build-ghostty/
.build-ssh/
Vendor/*.xcframework
Vendor/include/

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

.DS_Store

# Throwaway SSH server for scripts/selftest.sh — keys and logs, never shared.
.test-host/

# The Debian image the Linux machine boots. scripts/linux-image.sh builds
# it; at a hundred megabytes and more it is not for git.
Resources/linux/*.wasm
.linux-image/
.build-netstack/
Vendor/NetStack.xcframework
