+++ b/src/termio/External.zig
@@ -0,0 +1,231 @@
+//! External implements a termio backend whose bytes come from — and go to —
+//! the embedding application rather than a local child process on a pty.
+//!
+//! This exists for platforms where a terminal cannot own a process at all.
+//! On iOS `fork`/`exec` and pty allocation are unavailable to a sandboxed
+//! app, so the only way to drive a terminal there is to carry the stream
+//! yourself (over SSH, a serial link, a websocket) and hand the bytes to
+//! the emulator. `src/pty.zig` already anticipates this: it selects a
+//! `NullPty` on iOS with a TODO saying a termio that doesn't use a pty is
+//! what's actually wanted. This is that termio.
+//!
+//! The data path is inverted relative to `Exec`:
+//!
+//!   * Output (remote -> terminal) is *pushed* in by the embedder calling
+//!     `Termio.processOutput`. There is no read thread, because there is no
+//!     file descriptor to poll.
+//!   * Input (terminal -> remote) leaves through `write_cb`, invoked on the
+//!     io thread from `queueWrite`.
+//!   * A resize is reported through `resize_cb` so the embedder can pass the
+//!     new window size along (an SSH `window-change` request, say).
+//!
+//! Both callbacks are optional. A backend with neither is a terminal that
+//! renders whatever is pushed into it and drops what's typed — which is a
+//! legitimate configuration for a read-only viewer.
+const External = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+const ProcessInfo = @import("../pty.zig").ProcessInfo;
+
+const log = std.log.scoped(.io_external);
+
+/// Bytes are handed out in chunks no larger than this. The callback may be
+/// called more than once for a single `queueWrite`.
+const WRITE_CHUNK = 4096;
+
+/// Opaque embedder pointer passed back to every callback.
+userdata: ?*anyopaque,
+
+/// Called on the io thread when the terminal has bytes for the far end.
+/// The slice is only valid for the duration of the call; copy it.
+write_cb: ?WriteFn,
+
+/// Called when the terminal has been resized. The embedder is expected to
+/// forward this to whatever owns the remote pty.
+resize_cb: ?ResizeFn,
+
+pub const WriteFn = *const fn (
+    userdata: ?*anyopaque,
+    data: [*]const u8,
+    len: usize,
+) callconv(.c) void;
+
+pub const ResizeFn = *const fn (
+    userdata: ?*anyopaque,
+    columns: u16,
+    rows: u16,
+    width_px: u32,
+    height_px: u32,
+) callconv(.c) void;
+
+pub const Config = struct {
+    userdata: ?*anyopaque = null,
+    write_cb: ?WriteFn = null,
+    resize_cb: ?ResizeFn = null,
+};
+
+pub fn init(alloc: Allocator, cfg: Config) !External {
+    _ = alloc;
+    return .{
+        .userdata = cfg.userdata,
+        .write_cb = cfg.write_cb,
+        .resize_cb = cfg.resize_cb,
+    };
+}
+
+pub fn deinit(self: *External) void {
+    _ = self;
+}
+
+/// Report the terminal's starting size so the far end can match it before
+/// the first byte is written. `Exec` does the equivalent by sizing the pty
+/// here; we have no pty, so the embedder gets told instead.
+pub fn initTerminal(self: *External, t: *terminal.Terminal) void {
+    self.resize(.{
+        .columns = t.cols,
+        .rows = t.rows,
+    }, .{
+        .width = t.width_px,
+        .height = t.height_px,
+    }) catch {};
+}
+
+pub fn threadEnter(
+    self: *External,
+    alloc: Allocator,
+    io: *termio.Termio,
+    td: *termio.Termio.ThreadData,
+) !void {
+    _ = self;
+    _ = alloc;
+    _ = io;
+
+    // No process to spawn and no descriptor to poll, so there is nothing
+    // to arm on the loop. Output arrives by push.
+    td.backend = .{ .external = .{} };
+}
+
+pub fn threadExit(self: *External, td: *termio.Termio.ThreadData) void {
+    _ = self;
+    _ = td;
+}
+
+pub fn focusGained(
+    self: *External,
+    td: *termio.Termio.ThreadData,
+    focused: bool,
+) !void {
+    _ = self;
+    _ = td;
+    _ = focused;
+
+    // Exec polls termios here to track whether the child has echo off.
+    // There is no local child, so there is nothing to poll.
+}
+
+pub fn resize(
+    self: *External,
+    grid_size: renderer.GridSize,
+    screen_size: renderer.ScreenSize,
+) !void {
+    const cb = self.resize_cb orelse return;
+    cb(
+        self.userdata,
+        @intCast(grid_size.columns),
+        @intCast(grid_size.rows),
+        screen_size.width,
+        screen_size.height,
+    );
+}
+
+pub fn queueWrite(
+    self: *External,
+    alloc: Allocator,
+    td: *termio.Termio.ThreadData,
+    data: []const u8,
+    linefeed: bool,
+) !void {
+    _ = alloc;
+    _ = td;
+
+    const cb = self.write_cb orelse return;
+    if (data.len == 0) return;
+
+    // Fast path: hand the caller's slice straight through, chunked only so
+    // an embedder can rely on a bounded length.
+    if (!linefeed) {
+        var i: usize = 0;
+        while (i < data.len) {
+            const end = @min(data.len, i + WRITE_CHUNK);
+            cb(self.userdata, data[i..end].ptr, end - i);
+            i = end;
+        }
+        return;
+    }
+
+    // Slow path: the terminal is in linefeed mode, so every CR has to go
+    // out as CRLF. Translate into a stack buffer rather than allocating —
+    // this runs on the io thread for every keystroke.
+    var buf: [WRITE_CHUNK]u8 = undefined;
+    var buf_i: usize = 0;
+    for (data) |ch| {
+        // Worst case this byte becomes two, so flush with room to spare.
+        if (buf_i >= buf.len - 1) {
+            cb(self.userdata, &buf, buf_i);
+            buf_i = 0;
+        }
+
+        if (ch != '\r') {
+            buf[buf_i] = ch;
+            buf_i += 1;
+            continue;
+        }
+
+        buf[buf_i] = '\r';
+        buf[buf_i + 1] = '\n';
+        buf_i += 2;
+    }
+    if (buf_i > 0) cb(self.userdata, &buf, buf_i);
+}
+
+pub fn childExitedAbnormally(
+    self: *External,
+    gpa: Allocator,
+    t: *terminal.Terminal,
+    exit_code: u32,
+    runtime_ms: u64,
+) !void {
+    _ = self;
+    _ = gpa;
+    _ = t;
+    _ = exit_code;
+    _ = runtime_ms;
+
+    // There is no child, so this is unreachable in practice. The embedder
+    // signals a closed connection by tearing the surface down.
+}
+
+pub fn getProcessInfo(
+    self: *External,
+    comptime info: ProcessInfo,
+) ?ProcessInfo.Type(info) {
+    _ = self;
+
+    // The process lives on the far end of whatever the embedder is
+    // carrying; nothing local to report.
+    return null;
+}
+
+/// The thread local data for the external implementation. There is no loop
+/// state to keep — writes leave synchronously through the callback — but the
+/// backend union requires an arm.
+pub const ThreadData = struct {
+    pub fn deinit(self: *ThreadData, alloc: Allocator) void {
+        _ = self;
+        _ = alloc;
+    }
+};
