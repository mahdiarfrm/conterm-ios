+
+// forwardWinsize keeps a process told of the console's size.
+//
+// The console is not the container's controlling terminal, so when the
+// host resizes it the kernel's SIGWINCH reaches nobody. This polls the
+// size and raises the signal itself; runc answers it by resizing the
+// container's pty, and the shell inside sees a normal window change.
+func forwardWinsize(p *os.Process) (stop func()) {
+	done := make(chan struct{})
+	winsize := func() ([4]uint16, bool) {
+		var ws [4]uint16
+		_, _, e := syscall.Syscall(syscall.SYS_IOCTL, os.Stdin.Fd(), syscall.TIOCGWINSZ, uintptr(unsafe.Pointer(&ws)))
+		return ws, e == 0
+	}
+	last, _ := winsize()
+	go func() {
+		t := time.NewTicker(250 * time.Millisecond)
+		defer t.Stop()
+		for {
+			select {
+			case <-done:
+				return
+			case <-t.C:
+			}
+			ws, ok := winsize()
+			if !ok || ws == last {
+				continue
+			}
+			last = ws
+			p.Signal(syscall.SIGWINCH)
+		}
+	}()
+	return func() { close(done) }
+}
